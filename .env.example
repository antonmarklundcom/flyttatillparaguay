# =============================================================================
# flyttatillparaguay.se — miljövariabler
#
# Kopiera till .env.local för lokal utveckling. På Hostinger sätts samma
# variabler i hPanel → Environment Variables (aldrig i repot), och appen måste
# DEPLOYAS OM efter en ändring — en omstart räcker inte.
#
# Inget värde här är obligatoriskt för att bygga eller köra sajten. Saknas ett
# värde degraderar funktionen snyggt (plan.md §4.5).
# =============================================================================

# -----------------------------------------------------------------------------
# Sajten
# -----------------------------------------------------------------------------

# Publik bas-URL utan avslutande snedstreck. Används för canonical, OG-bilder,
# sitemap och robots. Sätt Hostinger-URL:en först (t.ex.
# https://xxx.hostingersite.com) och byt till domänen när DNS pekar rätt.
# Saknas den: faller tillbaka på https://flyttatillparaguay.se
NEXT_PUBLIC_SITE_URL=https://flyttatillparaguay.se

# WhatsApp-nummer för alla CTA:er, siffror i internationellt format utan +.
# HUMAN INPUT (plan.md §7) — tills Anton levererat numret används en
# dokumenterad platshållare och länkarna leder ingenstans vettigt.
NEXT_PUBLIC_WHATSAPP_NUMBER=595981123456

# Publik kontaktadress som visas i sidfot och på kontaktsidan.
NEXT_PUBLIC_CONTACT_EMAIL=hej@flyttatillparaguay.se

# -----------------------------------------------------------------------------
# VenderCRM — leadmottagning (skillen vendercrm-lead-capture)
# -----------------------------------------------------------------------------

# CRM:ets bas-URL, utan avslutande snedstreck.
VENDERCRM_URL=https://crm.dindomän.se

# Sajtens egen API-nyckel. Skapas i VenderCRM under "Sitios" och visas EN gång.
# HUMAN INPUT (plan.md §7).
#
# ALDRIG med NEXT_PUBLIC_-prefix: allt som heter så bakas in i klientbundlen och
# hade gjort det möjligt för vem som helst att skriva in i pipelinen.
# En nyckel per sajt — dela aldrig samma nyckel mellan två sajter.
#
# Saknas VENDERCRM_URL eller VENDERCRM_API_KEY går lead-routen i DEGRADERAT
# LÄGE: formulären fungerar precis som vanligt, besökaren ser sin tacksida, och
# hela payloaden loggas på servern i stället för att skickas. Inget lead går
# förlorat innan nyckeln finns på plats.
VENDERCRM_API_KEY=

# -----------------------------------------------------------------------------
# Noteringar
# -----------------------------------------------------------------------------
#
# Ingen databas och ingen auth i v1 (plan.md §1.3) — därför finns här varken
# DATABASE_URL, NEXTAUTH_SECRET eller NEXTAUTH_URL. Lägg inte till dem "för
# säkerhets skull"; en tom DATABASE_URL i hPanel har fått bygg att fallera förr.
