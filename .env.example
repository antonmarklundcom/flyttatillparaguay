# --- VenderCRM (lead capture) ---
# Bas-URL till CRM:et, utan avslutande slash. Ex: https://crm.vendercrm.com
VENDERCRM_URL=
# Sajtens egen API-nyckel (VenderCRM -> Sitios). ALDRIG NEXT_PUBLIC_.
# Saknas den kör lead-routen i "degraded mode": leadet loggas, besökaren tackas ändå.
VENDERCRM_API_KEY=

# --- Kontakt / CTA ---
# WhatsApp-nummer i internationellt format utan +, ex 595981123456. TODO-ANTON.
NEXT_PUBLIC_WHATSAPP_NUMBER=595000000000
# Publik e-post som visas på /kontakt.
NEXT_PUBLIC_CONTACT_EMAIL=hej@flyttatillparaguay.se

# --- Site ---
# Absolut bas-URL, används för canonical, OG och sitemap.
NEXT_PUBLIC_SITE_URL=https://flyttatillparaguay.se
